{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veil",
  "version": "0.1.0",
  "identifier": "nyc.veil.app",
  "build": {
    "frontendDist": "https://app.veil.nyc"
  },
  "app": {
    "windows": [
      {
        "title": "Veil",
        "width": 1200,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
