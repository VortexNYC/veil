{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veil-key-service",
  "account_id": "953346ce1b4f27fa04a76d83aeccab28",
  "compatibility_date": "2026-10-28",
  "main": "src/index.ts",
  "routes": [
    { "pattern": "keys.veil.nyc", "custom_domain": true }
  ],
  "secrets_store_secrets": [
    {
      "binding": "VEIL_KEK",
      "store_id": "965d27844ea34c2d9ad83eb61b372dac",
      "secret_name": "VEIL_KEK"
    },
    {
      "binding": "SERVICE_TOKEN",
      "store_id": "965d27844ea34c2d9ad83eb61b372dac",
      "secret_name": "SERVICE_TOKEN"
    }
  ]
}
