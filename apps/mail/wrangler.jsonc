{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veil-mail",
  "account_id": "953346ce1b4f27fa04a76d83aeccab28",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.tsx",
  "routes": [
    {
      "pattern": "mail.veil.nyc",
      "custom_domain": true
    }
  ],
  "vars": {
    "EMAIL_FROM": "Veil <noreply@veil.nyc>"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
