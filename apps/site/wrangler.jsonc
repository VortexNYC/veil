{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veil-site",
  "account_id": "953346ce1b4f27fa04a76d83aeccab28",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "veil.nyc/", "custom_domain": false },
    { "pattern": "veil.nyc/install.sh", "custom_domain": false },
    { "pattern": "veil.nyc/fonts/*", "custom_domain": false },
    { "pattern": "veil.nyc/favicon.ico", "custom_domain": false },
    { "pattern": "veil.nyc/security", "custom_domain": false },
    { "pattern": "veil.nyc/security.html", "custom_domain": false },
    { "pattern": "veil.nyc/privacy", "custom_domain": false },
    { "pattern": "veil.nyc/privacy.html", "custom_domain": false },
    { "pattern": "veil.nyc/terms", "custom_domain": false },
    { "pattern": "veil.nyc/terms.html", "custom_domain": false },
    { "pattern": "veil.nyc/.well-known/security.txt", "custom_domain": false },
    { "pattern": "veil.nyc/r/*", "custom_domain": false },
    { "pattern": "veil.nyc/releases/*", "custom_domain": false },
    { "pattern": "veil.nyc/robots.txt", "custom_domain": false }
  ]
}
