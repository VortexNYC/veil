{
  "name": "veil",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "login": "pnpm --filter identity-login dev",
    "vault": "pnpm --filter veil-vault dev",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "pnpm --filter identity-login typecheck && pnpm --filter veil-vault typecheck && pnpm --filter veil-phone typecheck",
    "scan:secrets": "secretlint . --no-gitignore --secretlintignore .secretlintignore",
    "sdk:generate": "pnpm exec tsx scripts/generate-sdks.ts",
    "docs:dev": "pnpm --filter @vortex-api/veil-docs dev",
    "docs:build": "pnpm --filter @vortex-api/veil-docs build",
    "prove:cli-golden-flow": "go test ./internal/cli ./internal/mcpserver ./internal/publicapi -count=1",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@e2e-dev/mobile": "^0.12.4",
    "@e2e-dev/web": "^0.15.3",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.98.2",
    "@openapitools/openapi-generator-cli": "^2.35.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "e2e": "^0.21.3",
    "esbuild": "^0.28.2",
    "railway": "^3.11.0",
    "secretlint": "^13.0.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-plus": "0.2.4"
  },
  "author": "Organization 13 Inc.",
  "license": "UNLICENSED"
}
