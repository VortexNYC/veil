# Copy to identity/.env. Do not commit identity/.env.
# KRATOS_CIPHER_SECRET must be exactly 32 characters: openssl rand -hex 16
# The others: openssl rand -hex 24

POSTGRES_PASSWORD=
KRATOS_COOKIE_SECRET=
KRATOS_CIPHER_SECRET=
HYDRA_SYSTEM_SECRET=
HYDRA_PAIRWISE_SALT=
HYDRA_CLIENT_ID=veil
BROKER_REDIRECT_URL=http://127.0.0.1:4460/oidc/callback
# Public token+JWKS only. Not admin. Local default is http://127.0.0.1:4444
# URLS_SELF_ISSUER=https://id.veil.nyc
